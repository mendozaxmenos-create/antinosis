generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// user | admin (p. ej. emails en ADMIN_EMAILS)
  role          String    @default("user")

  createdAt              DateTime                @default(now())
  /// app | email | telegram — dónde replicar alertas además del panel
  alertChannel           String                  @default("app")
  alertEmail             String?
  telegramChatId       String?
  /// OAuth refresh token para Google Calendar (tratar como secreto)
  googleRefreshToken     String?
  googleCalendarEmail    String?
  monthlyBudgetConfigs   MonthlyBudgetConfig[]
  creditCards            CreditCard[]
  alertEvents            AlertEvent[]
  statementImports       StatementImport[]
  reconciliationResults  ReconciliationResult[]
  salaryBonuses          SalaryBonus[]
  accounts               Account[]
  sessions               Session[]
}

/// NextAuth — cuentas OAuth / email vinculadas al usuario
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// NextAuth — sesiones DB (opcional si solo JWT; la tabla puede quedar vacía)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// NextAuth — tokens del magic link por email
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SalaryBonus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mes calendario al que imputás el bono (1–12)
  month     Int
  year      Int
  amount    Float
  label     String?
  createdAt DateTime @default(now())

  @@index([userId, year, month])
}

model MonthlyBudgetConfig {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  month               Int
  year                Int
  /// Sueldo neto del mes (ingreso principal)
  monthlyIncome       Float?
  /// Legado: antes el límite era ingreso × (allowed/100). Si savingsPercentage está definido, se ignora en el cálculo nuevo.
  allowedPercentage   Float?
  /// Efectivo transferido a Soledad (se resta del sueldo neto antes de ahorro y límite tarjeta)
  soledadCashTransfer Float            @default(0)
  /// % del disponible (neto − Soledad) destinado a ahorro; el límite en tarjeta es el resto (salvo tope manual)
  savingsPercentage   Float?
  manualCardLimit     Float?
  computedCardLimit   Float
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  alertThresholds     AlertThreshold[]

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model AlertThreshold {
  id                    String              @id @default(cuid())
  percentage            Int
  enabled               Boolean             @default(true)
  monthlyBudgetConfigId String
  monthlyBudgetConfig   MonthlyBudgetConfig @relation(fields: [monthlyBudgetConfigId], references: [id], onDelete: Cascade)

  @@unique([monthlyBudgetConfigId, percentage])
}

model CreditCard {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank       String
  name       String
  brand      String?
  last4      String
  closingDay Int
  dueDay     Int
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  expenses   Expense[]
  statementImports StatementImport[]

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  active   Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id                   String                 @id @default(cuid())
  transactionDate      DateTime
  postedMonth          Int
  postedYear           Int
  amount               Float
  /// Moneda original del movimiento importado (p. ej. USD antes de convertir a ARS con cotización BCRA)
  originalCurrency     String?
  /// Monto en moneda original cuando aplica (ej. dólares del resumen)
  originalAmount       Float?
  description          String?
  merchant             String?
  installments         Int                    @default(1)
  notes                String?
  /// manual | imported_pdf | imported_file | imported_manual (total resumen sin archivo)
  sourceType           String
  /// pending | matched | unmatched | adjusted
  reconciliationStatus String                 @default("pending")
  /// Resumen del cual proviene (totales a pagar por archivo importado)
  statementImportId    String?
  statementImport      StatementImport?       @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  cardId               String
  card                 CreditCard             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  categoryId           String
  category             Category               @relation(fields: [categoryId], references: [id])
  createdAt            DateTime               @default(now())

  @@index([postedYear, postedMonth])
  @@index([cardId])
  @@index([transactionDate])
  @@index([statementImportId])
}

model AlertEvent {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month               Int
  year                Int
  /// threshold | payment_due
  alertKind           String   @default("threshold")
  /// Solo alertas de presupuesto (null si es payment_due)
  thresholdPercentage Int?
  message             String
  /// Fecha de vencimiento de pago (resumen importado)
  dueDate             DateTime?
  statementImportId   String?
  triggeredAt         DateTime @default(now())

  @@index([userId, year, month])
  @@index([alertKind])
}

model StatementImport {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId      String?
  card        CreditCard?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  bank        String
  fileName    String
  importMonth Int
  importYear  Int
  /// pending | processing | completed | failed
  status      String                @default("pending")
  /// Vencimiento de pago calculado según la tarjeta (día de vencimiento)
  paymentDueDate DateTime?
  rowCount    Int?
  /// ID del evento en Google Calendar (si se creó al importar)
  googleCalendarEventId String?
  createdAt   DateTime              @default(now())
  expenses    Expense[]
}

model ReconciliationResult {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                  Int
  year                   Int
  matchedCount           Int
  unmatchedManualCount Int
  unmatchedImportedCount Int
  createdAt              DateTime @default(now())

  @@unique([userId, month, year])
}
