# PostgreSQL (Neon, Supabase, Vercel Postgres, local Docker, etc.)
# Ejemplo Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# npm run db:seed — solo asegura categorías (sin usuario ni datos de prueba).
# Primera vez: abrí /setup en el navegador y creá tu perfil.
# Borrar todos los datos y dejar solo categorías: npm run db:wipe (local) o npm run db:wipe:production tras vercel env pull.
# Después: /setup en el navegador.
# Producción solo categorías: npm run db:seed:production

# URL pública de la app (local o la que te da Vercel, ej. https://antinosis.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: si está definida, toda la app (salvo /login) exige esta contraseña; cookie httpOnly 30 días.
# En Vercel: agregala en Environment Variables para producción. Compatible con OAuth (a diferencia de Basic Auth).
# APP_PASSWORD=""

# Google Calendar — OAuth (opcional)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/google-calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Alertas por Telegram (opcional) — token del bot desde @BotFather
TELEGRAM_BOT_TOKEN=""

# Alertas por email (opcional) — https://resend.com
RESEND_API_KEY=""
RESEND_FROM="CardSpend <onboarding@tudominio.com>"
